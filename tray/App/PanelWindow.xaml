<Window x:Class="TelegramMCPTray.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:TelegramMCPTray"
        xmlns:core="clr-namespace:TelegramMCPTray.Core;assembly=TelegramMCPTray.Core"
        Title="Telegram MCP" Width="404" SizeToContent="Height" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource PanelBg}"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- A round avatar: initials, covered by the profile photo once it has loaded. -->
        <DataTemplate DataType="{x:Type local:Avatar}">
            <Grid Width="34" Height="34">
                <Ellipse Fill="{Binding Fill}" />
                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Visibility="{Binding Photo.HasImage, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Photo.Image}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Stroke="#33FFFFFF" StrokeThickness="1" />
            </Grid>
        </DataTemplate>

        <!-- A tile at the top of Home: label, big number, chip. Click it to show its section below; the
             one showing is tinted with the accent. -->
        <DataTemplate x:Key="StatTemplate" DataType="{x:Type local:StatVM}">
            <!-- Four tiles, two by two: the number and its chip side by side, so a chip like "2 sessions" fits. -->
            <Button Style="{StaticResource Flat}" Command="{Binding Pick}" Margin="4,0,4,8" ToolTip="{Binding Tip}"
                    AutomationProperties.Name="{Binding Name}">
                <Border x:Name="Tile" Style="{StaticResource CardStyle}" Padding="12,8,10,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" />
                        <DockPanel Margin="0,1,0,0">
                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <ContentControl Content="{Binding Chip}" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,-4,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Tile" Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "You're all caught up": a glyph in a soft circle, a line, and what would show up here. -->
        <Style x:Key="EmptyTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>

        <!-- A draft waiting for approval. A long one opens on click (or Show all), never on hover.
             An edit of a message Claude sent shows its text now and the new text; a delete, the message that would go. -->
        <DataTemplate x:Key="ApprovalTemplate" DataType="{x:Type local:ApprovalVM}">
            <Border Margin="0,12,0,0" CornerRadius="12" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource PendingEdge}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding Avatar}" Focusable="False" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding To}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,2,0,0">
                            <local:SvgIcon Kind="clock" Width="13" Height="13" Foreground="{DynamicResource Fg3}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding AgoText}" FontSize="11" Foreground="{DynamicResource Fg3}" />
                        </StackPanel>
                    </Grid>

                    <!-- An edit or delete: which message, and what would happen to it. -->
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding IsChange, Converter={StaticResource Visible}}">
                        <local:SvgIcon Kind="{Binding ChangeIcon}" Width="14" Height="14" DockPanel.Dock="Left" Foreground="{DynamicResource Fg3}" VerticalAlignment="Top" Margin="0,1,6,0" />
                        <TextBlock Text="{Binding ChangeLine}" Style="{StaticResource Caption}" />
                    </DockPanel>

                    <Button x:Name="BodyButton" Margin="0,10,0,0" Style="{StaticResource Flat}" Command="{Binding ToggleText}" Focusable="{Binding IsLong}"
                            ToolTip="{Binding BodyTip}" AutomationProperties.Name="Message text">
                        <StackPanel>
                            <TextBlock Text="Now" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg3}" Margin="0,0,0,3"
                                       Visibility="{Binding IsEdit, Converter={StaticResource Visible}}" />
                            <Border CornerRadius="10" Background="{DynamicResource Subtle}" Padding="10,8" Margin="0,0,0,6"
                                    Visibility="{Binding IsEdit, Converter={StaticResource Visible}}">
                                <TextBlock x:Name="Previous" Text="{Binding PreviousText}" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="68" />
                            </Border>
                            <TextBlock Text="Will say" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg3}" Margin="0,0,0,3"
                                       Visibility="{Binding IsEdit, Converter={StaticResource Visible}}" />
                            <Border x:Name="BodyBox" CornerRadius="10" Background="{DynamicResource Subtle2}" Padding="10,8">
                                <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="68" />
                            </Border>
                            <TextBlock Text="{Binding ExpandLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Right" Margin="0,4,2,0"
                                       Visibility="{Binding IsLong, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Button>

                    <!-- Who wants to send it, and why it waits for you. -->
                    <DockPanel Margin="0,8,0,0">
                        <local:SvgIcon Kind="terminal" Width="14" Height="14" DockPanel.Dock="Left" Foreground="{DynamicResource Fg3}" VerticalAlignment="Top" Margin="0,1,6,0" />
                        <TextBlock Text="{Binding AskedBy}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                    <DockPanel Margin="0,3,0,0">
                        <local:SvgIcon Kind="info" Width="14" Height="14" DockPanel.Dock="Left" Foreground="{DynamicResource Fg3}" VerticalAlignment="Top" Margin="0,1,6,0" />
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxHeight="30" ToolTip="{Binding Reason}" />
                    </DockPanel>

                    <!-- First message to a chat: say so plainly, and it gets saved under this nickname. -->
                    <Border Margin="0,10,0,0" CornerRadius="10" Padding="10,8" Background="{DynamicResource BlueWash}" Visibility="{Binding FirstTime, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <DockPanel>
                                <local:SvgIcon Kind="user-plus" Width="15" Height="15" Foreground="{DynamicResource Blue}" Margin="0,0,6,0" />
                                <TextBlock Text="First message to this chat" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" Margin="0,3,0,0"
                                       Text="Pick how to send it: ask you again next time, or trust this chat and send without asking from now on." />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Save as" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ExistingNickname}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Visibility="{Binding HasNickname, Converter={StaticResource Visible}}" />
                                <TextBox Text="{Binding Nick, UpdateSourceTrigger=PropertyChanged}" MaxWidth="170" HorizontalAlignment="Left"
                                         FontSize="12" FontWeight="SemiBold" Padding="10,4" IsEnabled="{Binding Idle}"
                                         ToolTip="The nickname you'll use for this chat, e.g. “send to leo”"
                                         Visibility="{Binding AsksNickname, Converter={StaticResource Visible}}" />
                            </DockPanel>
                            <!-- The two ways to send it, side by side under the explanation they answer. -->
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <local:PillButton x:Name="AskNext" Content="Send, ask next time" Tint="{DynamicResource Orange}" Margin="0,0,4,0"
                                                  HorizontalAlignment="Stretch" Command="{Binding AskEveryTime}" IsEnabled="{Binding Idle}"
                                                  ToolTip="Send now. Future messages to this chat wait for you too (Ask every time)." />
                                <local:PillButton x:Name="Always" Content="Send, always allow" Filled="True" Tint="{DynamicResource GreenFill}" Margin="4,0,0,0"
                                                  HorizontalAlignment="Stretch" Command="{Binding AlwaysAllow}" IsEnabled="{Binding Idle}"
                                                  ToolTip="Send now and trust this chat: future messages send without asking" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Deny, and Send for a chat that has a rule (a new chat's two ways to send are in its box above).
                         An edit offers Deny / Edit, a delete Keep / Delete. -->
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                        <local:PillButton x:Name="DenyButton" Content="{Binding DenyLabel}" Tint="{DynamicResource Red}" Command="{Binding Deny}" IsEnabled="{Binding Idle}" Margin="8,4,0,0" MinWidth="76"
                                          ToolTip="{Binding DenyTip}" />
                        <local:PillButton x:Name="Approve" Filled="True" Tint="{DynamicResource GreenFill}" Margin="8,4,0,0"
                                          Command="{Binding Approve}" IsEnabled="{Binding Idle}" ToolTip="{Binding ApproveTip}"
                                          Visibility="{Binding FirstTime, Converter={StaticResource Hidden}}">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgIcon Kind="{Binding ApproveIcon}" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="ApproveText" Text="{Binding ApproveLabel}" />
                            </StackPanel>
                        </local:PillButton>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="True">
                    <Setter TargetName="Body" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
                    <Setter TargetName="Previous" Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDelete}" Value="True">
                    <Setter TargetName="BodyBox" Property="Background" Value="{DynamicResource RedWash}" />
                    <Setter TargetName="DenyButton" Property="Tint" Value="{DynamicResource Fg2}" />
                    <Setter TargetName="Approve" Property="Tint" Value="{DynamicResource RedFill}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLong}" Value="False">
                    <Setter TargetName="BodyButton" Property="Cursor" Value="Arrow" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                    <Setter TargetName="Always" Property="Content" Value="Sending…" />
                    <Setter TargetName="AskNext" Property="Content" Value="Sending…" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A Claude session listening to chats; each chat is a chip. -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type local:SessionVM}">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" VerticalAlignment="Top" Margin="0,0,10,0">
                    <local:SvgIcon Kind="terminal" Width="17" Height="17" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <DockPanel MinHeight="20">
                        <!-- Every saved chat this session listens to, together (other sessions on them pause too). -->
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="{Binding HasAll, Converter={StaticResource Visible}}"
                                    ToolTip="Pause or resume every chat this session listens to (other sessions on those chats pause too)">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AnyOn, Mode=OneWay}" Command="{Binding ToggleAll}"
                                          IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding AllName}" />
                            <TextBlock Text="all" FontSize="9" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <ContentControl Content="{Binding Tag}" Focusable="False" HorizontalAlignment="Left" Margin="-4,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Watches}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <!-- One chat it listens to, with the switch that pauses or resumes it (its auto-reply).
                                 The switch, "listening" / "paused" and the dot bind to the chat's Contacts row,
                                 so they follow a change at once, and wait while it saves. -->
                            <DataTemplate DataType="{x:Type local:WatchVM}">
                                <DockPanel Margin="0,4,0,0" ToolTip="{Binding Tooltip}">
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="8,0,0,0"
                                                  IsChecked="{Binding Contact.Listens, Mode=OneWay}" Command="{Binding Contact.ToggleListen}"
                                                  IsEnabled="{Binding Contact.Idle, FallbackValue=False}"
                                                  ToolTip="{Binding Contact.ListenTip}" AutomationProperties.Name="{Binding Contact.ListenName}"
                                                  Visibility="{Binding CanToggle, Converter={StaticResource Visible}}" />
                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource Blue}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="Name" Text="{Binding ChatLabel}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis"><Run
                                            Text="{Binding Contact.ListenWord, Mode=OneWay, FallbackValue=listening}" /><Run Text="{Binding DetailRest, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Contact.Listens}" Value="False">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Fg3}" />
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Fg2}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A chat sent to lately. Click it to show (or hide) what was sent; nothing opens on hover. -->
        <DataTemplate x:Key="RecentTemplate" DataType="{x:Type local:RecentChatVM}">
            <Border x:Name="Row" Margin="-8,6,-8,0" CornerRadius="12" Padding="8,6" Background="Transparent">
                <StackPanel>
                    <Button Style="{StaticResource Flat}" Command="{Binding Toggle}" ToolTip="Show what was sent" AutomationProperties.Name="{Binding Label}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding Avatar}" Focusable="False" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Fg3}" />
                            </StackPanel>
                            <local:SvgIcon Kind="{Binding Chevron}" Width="13" Height="13" Grid.Column="2" Foreground="{DynamicResource Fg3}" Margin="8,0,4,0" />
                        </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="44,8,0,0" Focusable="False"
                                  Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RecentMessageVM}">
                                <Border Margin="0,0,0,6" CornerRadius="12,12,12,4" Background="{DynamicResource AccentSoft}" Padding="10,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource Fg3}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Subtle}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Subtle}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One setting on an open contact: a title and a line saying what it does. -->
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,7" />
        </Style>
        <!-- The track a set of choices sits in, like a segmented control. -->
        <Style x:Key="Segments" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Subtle2}" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- A saved chat on the Contacts tab: click to open; one is open at a time. -->
        <!-- A saved chat's avatar: a person's photo or initials; a group's, channel's or bot's glyph,
             covered by its own photo once that has loaded. On Contacts and in Home's "Chats Claude may
             listen to" (scaled down there). -->
        <DataTemplate x:Key="ContactAvatar" DataType="{x:Type local:ContactVM}">
            <Grid Width="34" Height="34">
                <ContentControl Content="{Binding Avatar}" Focusable="False" Visibility="{Binding ShowsGlyph, Converter={StaticResource Hidden}}" />
                <Border CornerRadius="17" Background="{Binding Avatar.Fill}" Visibility="{Binding ShowsGlyph, Converter={StaticResource Visible}}">
                    <local:SvgIcon Kind="{Binding KindIcon}" Width="17" Height="17" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <Ellipse DataContext="{Binding Avatar.Photo}" Visibility="{Binding HasImage, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContactTemplate" DataType="{x:Type local:ContactVM}">
            <Border x:Name="Card" Margin="0,0,0,10" Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <!-- The row: click the name (or the chevron) to open it; the Auto-reply switch saves at once. -->
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Flat}" Command="{Binding Toggle}" ToolTip="Show this chat's settings" AutomationProperties.Name="{Binding Nickname}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContactAvatar}" Focusable="False"
                                                Margin="0,0,10,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nickname}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource IfSet}}" />
                                    <WrapPanel Margin="-4,5,0,0">
                                        <ContentControl Content="{Binding ModeTag}" Focusable="False" Margin="0,0,0,2" />
                                        <ContentControl Content="{Binding PageFromTag}" Focusable="False" Margin="0,0,0,2" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Auto-reply: a Claude session may watch this chat and answer new messages">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Listens, Mode=OneWay}" Command="{Binding ToggleListen}"
                                          IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding ListenName}" />
                            <TextBlock Text="Auto-reply" FontSize="9" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Flat}" Command="{Binding Toggle}" Focusable="False" Margin="6,0,0,0">
                            <local:SvgIcon Kind="{Binding Chevron}" Width="13" Height="13" Foreground="{DynamicResource Fg3}" Margin="2,0" />
                        </Button>
                    </Grid>

                    <StackPanel Margin="14,0,14,14" IsEnabled="{Binding Idle}" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                        <Border Height="1" Background="{DynamicResource Divider}" />

                        <!-- In plain words first: what happens with this chat right now. -->
                        <Border Margin="0,12,0,0" CornerRadius="10" Background="{DynamicResource Subtle}" Padding="10,8">
                            <DockPanel>
                                <local:SvgIcon Kind="info" Width="15" Height="15" DockPanel.Dock="Left" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding Explanation}" FontSize="11" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SettingTitle}" Text="When Claude sends a message here" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Always allow sends at once; Ask every time waits for you here; Blocked never sends." />
                        <Border Style="{StaticResource Segments}">
                            <StackPanel Orientation="Horizontal">
                                <local:PillButton Content="Always allow" Choice="True" Tint="{DynamicResource GreenFill}" Filled="{Binding IsAutoSend, Mode=OneWay}"
                                                  Command="{Binding SetMode}" CommandParameter="autoSend" />
                                <local:PillButton Content="Ask every time" Choice="True" Tint="{DynamicResource OrangeFill}" Filled="{Binding IsAsk, Mode=OneWay}"
                                                  Command="{Binding SetMode}" CommandParameter="requireApproval" />
                                <local:PillButton Content="Blocked" Choice="True" Tint="{DynamicResource RedFill}" Filled="{Binding IsBlocked, Mode=OneWay}"
                                                  Command="{Binding SetMode}" CommandParameter="blocked" />
                            </StackPanel>
                        </Border>

                        <!-- The same switch as on the row, spelled out where the chat's settings are. -->
                        <TextBlock Style="{StaticResource SettingTitle}" Text="Auto-reply" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{Binding ListenCaption}" />
                        <Border Style="{StaticResource Segments}">
                            <StackPanel Orientation="Horizontal">
                                <local:PillButton Content="On" MinWidth="60" Choice="True" Tint="{DynamicResource BlueFill}" Filled="{Binding Listens, Mode=OneWay}"
                                                  Command="{Binding SetListen}" CommandParameter="on" AutomationProperties.Name="Auto-reply on"
                                                  ToolTip="A Claude session may watch this chat and answer new messages (the autoReply list)" />
                                <local:PillButton Content="Off" MinWidth="60" Choice="True" Tint="{DynamicResource GrayFill}" Filled="{Binding NotListens, Mode=OneWay}"
                                                  Command="{Binding SetListen}" CommandParameter="off" AutomationProperties.Name="Auto-reply off"
                                                  ToolTip="No session can listen here; a watch on it pauses" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding CanPage, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Can page me" />
                            <TextBlock Style="{StaticResource SettingHint}" Text="Their /page rings an alarm on this PC until you answer it." />
                            <Border Style="{StaticResource Segments}">
                                <StackPanel Orientation="Horizontal">
                                    <local:PillButton Content="On" MinWidth="60" Choice="True" Tint="{DynamicResource OrangeFill}" Filled="{Binding PageOn, Mode=OneWay}"
                                                      Command="{Binding SetPageFrom}" CommandParameter="on"
                                                      ToolTip="Their /page rings your desktop until you ack it (paging.pageFrom)" />
                                    <local:PillButton Content="Off" MinWidth="60" Choice="True" Tint="{DynamicResource GrayFill}" Filled="{Binding PageOff, Mode=OneWay}"
                                                      Command="{Binding SetPageFrom}" CommandParameter="off" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding PageTitle}" />
                            <TextBlock Style="{StaticResource SettingHint}" Text="Sends them “/page &lt;reason&gt;” from your account. It rings if you're on their list." />
                            <DockPanel>
                                <local:PillButton DockPanel.Dock="Right" Content="{Binding PageButtonText}" Filled="True" Tint="{DynamicResource RedFill}" Margin="8,0,0,0"
                                                  Command="{Binding SendPage}"
                                                  ToolTip="Sends “/page &lt;reason&gt;” from your account. It rings them if you're on their pageFrom." />
                                <Grid>
                                    <TextBox x:Name="Reason" Text="{Binding PageReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reason (optional)">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SendPage}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock x:Name="ReasonHint" Text="Reason (optional)" Foreground="{DynamicResource Fg3}" Margin="11,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                </Grid>
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SettingTitle}" Text="Nickname" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="The name you use with Claude, as in “send to leo”." />
                        <DockPanel>
                            <local:PillButton DockPanel.Dock="Right" Content="Rename" Tint="{DynamicResource Accent}" Margin="8,0,0,0" Command="{Binding Rename}" />
                            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding Rename}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>

                        <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PageReason}" Value="">
                    <Setter TargetName="ReasonHint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- An away schedule on the Away tab: a row (its colour and icon, name, hours, days, switch) that
             opens into the editor. The switch saves at once; everything in the editor waits for Save. -->
        <DataTemplate x:Key="ScheduleTemplate" DataType="{x:Type local:ScheduleVM}">
            <Border x:Name="Card" Margin="0,0,0,10" Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Flat}" Command="{Binding Toggle}" ToolTip="Show this schedule's settings" AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Ellipse Fill="{Binding Color}" Opacity="0.18" />
                                    <local:SvgIcon Kind="{Binding Icon}" Width="17" Height="17" Foreground="{Binding Color}" HorizontalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        <Border CornerRadius="9" Background="{DynamicResource GreenWash}" Padding="7,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Active, Converter={StaticResource Visible}}">
                                            <TextBlock Text="replying now" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Green}" />
                                        </Border>
                                        <Border CornerRadius="9" Background="{DynamicResource PendingWash}" Padding="7,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsNew, Converter={StaticResource Visible}}">
                                            <TextBlock Text="not added yet" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Orange}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Fg3}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding ToggleEnabled}" IsEnabled="{Binding Idle}"
                                      ToolTip="{Binding EnabledTip}" AutomationProperties.Name="{Binding EnabledName}"
                                      Visibility="{Binding IsNew, Converter={StaticResource Hidden}}" />
                        <Button Grid.Column="2" Style="{StaticResource Flat}" Command="{Binding Toggle}" Focusable="False" Margin="6,0,0,0">
                            <local:SvgIcon Kind="{Binding Chevron}" Width="13" Height="13" Foreground="{DynamicResource Fg3}" Margin="2,0" />
                        </Button>
                    </Grid>

                    <StackPanel Margin="14,0,14,14" IsEnabled="{Binding Idle}" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                        <Border Height="1" Background="{DynamicResource Divider}" />

                        <TextBlock Style="{StaticResource SettingTitle}" Text="Name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,6,0,0" FontWeight="SemiBold"
                                 AutomationProperties.Name="Schedule name" />

                        <TextBlock Style="{StaticResource SettingTitle}" Text="Time" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="This PC's clock." />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="96" ItemsSource="{Binding FromOptions}" SelectedItem="{Binding From}" AutomationProperties.Name="Starts at" />
                            <TextBlock Text="to" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="10,0" />
                            <ComboBox Width="96" ItemsSource="{Binding UntilOptions}" SelectedItem="{Binding Until}" AutomationProperties.Name="Ends at" />
                        </StackPanel>
                        <TextBlock Text="{Binding Overnight}" Style="{StaticResource Caption}" Margin="2,6,0,0"
                                   Visibility="{Binding Overnight, Converter={StaticResource IfSet}}" />

                        <DockPanel Margin="0,14,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Flat}" Command="{Binding SetDays}" CommandParameter="all" Margin="0,0,10,0">
                                    <TextBlock Text="Every day" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                </Button>
                                <Button Style="{StaticResource Flat}" Command="{Binding SetDays}" CommandParameter="weekdays" Margin="0,0,10,0">
                                    <TextBlock Text="Weekdays" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                </Button>
                                <Button Style="{StaticResource Flat}" Command="{Binding SetDays}" CommandParameter="weekends">
                                    <TextBlock Text="Weekends" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                </Button>
                            </StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Days" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Days}" Focusable="False" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DayChipVM}">
                                    <local:PillButton Content="{Binding Letter}" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding On, Mode=OneWay}"
                                                      Command="{Binding Toggle}" Margin="1,0" Padding="0" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SettingTitle}" Text="Dates" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Every week on those days, or only between two dates (a trip, a holiday)." />
                        <Border Style="{StaticResource Segments}">
                            <StackPanel Orientation="Horizontal">
                                <local:PillButton Content="Every week" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding Weekly, Mode=OneWay}"
                                                  Command="{Binding SetDated}" CommandParameter="week" />
                                <local:PillButton Content="Between dates" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding Dated, Mode=OneWay}"
                                                  Command="{Binding SetDated}" CommandParameter="dates" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding Dated, Converter={StaticResource Visible}}">
                            <local:DateField SelectedDate="{Binding StartDate}" Hint="First day" />
                            <TextBlock Text="to" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="10,0" />
                            <local:DateField SelectedDate="{Binding EndDate}" Hint="Last day" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource SettingTitle}" Text="Wait for me first" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{Binding DelayHint}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Segments}">
                            <ItemsControl ItemsSource="{Binding DelayChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ChoiceVM}">
                                        <local:PillButton Content="{Binding Label}" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding On, Mode=OneWay}"
                                                          Command="{Binding DataContext.SetDelay, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" ToolTip="{Binding Tip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Style="{StaticResource SettingTitle}" Text="Reply again" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="{Binding RepeatHint}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Segments}">
                            <ItemsControl ItemsSource="{Binding RepeatChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ChoiceVM}">
                                        <local:PillButton Content="{Binding Label}" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding On, Mode=OneWay}"
                                                          Command="{Binding DataContext.SetRepeat, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" ToolTip="{Binding Tip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Command="{Binding InsertName}" VerticalAlignment="Bottom"
                                    ToolTip="Add {name}, which becomes your first name">
                                <TextBlock Text="+ {name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                            </Button>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Message" />
                        </DockPanel>
                        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                 MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="1000"
                                 AutomationProperties.Name="Away message" />
                        <TextBlock Text="{Binding Counter}" FontSize="10" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Right" Margin="0,3,4,0" />

                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Text="What they get" Margin="0,4,0,6" />
                        <Border CornerRadius="14,14,14,4" Background="{DynamicResource AccentSoft}" Padding="11,8" HorizontalAlignment="Left" MaxWidth="300">
                            <TextBlock Text="{Binding Preview}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <DockPanel Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource IfSet}}">
                            <local:SvgIcon Kind="triangle-alert" Width="14" Height="14" DockPanel.Dock="Left" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource Red}" TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Margin="0,14,0,0">
                            <local:PillButton x:Name="DeleteButton" DockPanel.Dock="Left" Tint="{DynamicResource Red}" Command="{Binding Delete}" ToolTip="Remove this schedule">
                                <StackPanel Orientation="Horizontal">
                                    <local:SvgIcon Kind="trash-2" Width="13" Height="13" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding DeleteLabel}" />
                                </StackPanel>
                            </local:PillButton>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <local:PillButton Content="Discard" Tint="{DynamicResource Fg2}" Command="{Binding Discard}" Margin="0,0,8,0"
                                                  Visibility="{Binding IsNew, Converter={StaticResource Hidden}}" ToolTip="Put back what is saved" />
                                <local:PillButton Content="{Binding SaveLabel}" Filled="True" Tint="{DynamicResource AccentFill}" MinWidth="76" Command="{Binding Save}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConfirmDelete}" Value="True">
                    <Setter TargetName="DeleteButton" Property="Filled" Value="True" />
                    <Setter TargetName="DeleteButton" Property="Tint" Value="{DynamicResource RedFill}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <DockPanel>
            <!-- Header: who you are and whether it's connected, the tabs, then the flash message. -->
            <StackPanel DockPanel.Dock="Top" Margin="18,18,18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- The app's icon (docs/icon.svg): a paper plane on a frosted disc. -->
                    <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0" Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Viewbox Width="24" Height="24" Margin="0,1,1,0">
                            <Path Data="{StaticResource PlaneGeometry}" Fill="{DynamicResource Brand}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Telegram MCP" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                        <!-- Status pill: green online, yellow reconnecting, red logged out, grey offline. -->
                        <Border CornerRadius="10" Padding="7,2,9,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource GrayWash}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Header.Kind}" Value="Good">
                                            <Setter Property="Background" Value="{DynamicResource GreenWash}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Header.Kind}" Value="Busy">
                                            <Setter Property="Background" Value="{DynamicResource YellowWash}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Header.Kind}" Value="Bad">
                                            <Setter Property="Background" Value="{DynamicResource RedWash}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Gray}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Header.Kind}" Value="Good">
                                                    <Setter Property="Fill" Value="{DynamicResource Green}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Header.Kind}" Value="Busy">
                                                    <Setter Property="Fill" Value="{DynamicResource Yellow}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Header.Kind}" Value="Bad">
                                                    <Setter Property="Fill" Value="{DynamicResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Header.Text}" FontSize="11" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                           ToolTip="{Binding Header.Text}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundButton}" Command="{Binding OpenRules}"
                                ToolTip="Rules: open config.json, where every chat's rules live" AutomationProperties.Name="Rules">
                            <local:SvgIcon Kind="settings" />
                        </Button>
                        <Button Style="{StaticResource RoundButton}" Command="{Binding OpenLog}" Margin="8,0,0,0"
                                ToolTip="Log: open daemon.log, for when something looks wrong" AutomationProperties.Name="Log">
                            <local:SvgIcon Kind="scroll-text" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tabs: Home (approvals, listening, recent), Contacts (each chat's rules), Away (the away schedules) and Footer. -->
                <Border Margin="0,16,0,0" CornerRadius="19" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="3">
                    <UniformGrid Columns="4">
                        <local:PillButton Style="{StaticResource Tab}" Filled="{Binding MainPage, Mode=OneWay}" Command="{Binding ShowMain}" ToolTip="Home (Ctrl+1)">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgIcon Kind="house" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="Home" />
                                <Border CornerRadius="8" Background="{DynamicResource BadgeBg}" Padding="5,0" Margin="4,0,0,0" MinWidth="15"
                                        Visibility="{Binding ApprovalCount, Converter={StaticResource IfSet}}">
                                    <TextBlock Text="{Binding ApprovalCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BadgeFg}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </local:PillButton>
                        <local:PillButton Style="{StaticResource Tab}" Filled="{Binding ContactsPage, Mode=OneWay}" Command="{Binding ShowContacts}" ToolTip="Contacts (Ctrl+2)">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgIcon Kind="users" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="Contacts" />
                            </StackPanel>
                        </local:PillButton>
                        <local:PillButton Style="{StaticResource Tab}" Filled="{Binding AwayPage, Mode=OneWay}" Command="{Binding ShowAway}" ToolTip="Away: replies for you while you're away, on schedules (Ctrl+3)">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgIcon Kind="moon" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="Away" />
                                <!-- Green while away replies can go out. -->
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Green}" Margin="5,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding AwayBadge, Converter={StaticResource IfSet}}" />
                            </StackPanel>
                        </local:PillButton>
                        <local:PillButton Style="{StaticResource Tab}" Filled="{Binding FooterPage, Mode=OneWay}" Command="{Binding ShowFooter}" ToolTip="Footer: the line under every message sent for you (Ctrl+4)">
                            <StackPanel Orientation="Horizontal">
                                <local:SvgIcon Kind="type" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="Footer" />
                            </StackPanel>
                        </local:PillButton>
                    </UniformGrid>
                </Border>

                <!-- Contacts: the search pill and what the tab is for. -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding ContactsPage, Converter={StaticResource Visible}}">
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,32,8" FontSize="12" />
                        <local:SvgIcon Kind="search" Width="16" Height="16" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search by nickname, name, @username or id" Foreground="{DynamicResource Fg3}" Margin="36,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SearchEmpty, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource Flat}" HorizontalAlignment="Right" Margin="0,0,12,0" Command="{Binding ClearSearch}" ToolTip="Clear (Esc)" AutomationProperties.Name="Clear search"
                                Visibility="{Binding SearchEmpty, Converter={StaticResource Hidden}}">
                            <local:SvgIcon Kind="x" Width="13" Height="13" Foreground="{DynamicResource Fg3}" />
                        </Button>
                    </Grid>
                    <!-- Filter: every chat, or only those with auto-reply on (or off). -->
                    <Border Style="{StaticResource Segments}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <local:PillButton Content="All" MinWidth="50" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding FilterAll, Mode=OneWay}"
                                              Command="{Binding SetFilter}" CommandParameter="all" ToolTip="Every saved chat" />
                            <local:PillButton Content="Auto-reply on" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding FilterOn, Mode=OneWay}"
                                              Command="{Binding SetFilter}" CommandParameter="on" ToolTip="Chats Claude may listen to and reply in" />
                            <local:PillButton Content="Auto-reply off" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding FilterOff, Mode=OneWay}"
                                              Command="{Binding SetFilter}" CommandParameter="off" ToolTip="Chats Claude can't listen to" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ContactsSummary}" Style="{StaticResource Caption}" Margin="4,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>

                <!-- What just happened: a green check when it worked, a red warning when it didn't. -->
                <Border Margin="0,12,0,0" CornerRadius="12" Padding="12,9" Visibility="{Binding Flash, Converter={StaticResource IfSet}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GreenWash}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FlashOk}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource RedWash}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <local:SvgIcon DockPanel.Dock="Left" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,8,0">
                            <local:SvgIcon.Style>
                                <Style TargetType="local:SvgIcon">
                                    <Setter Property="Kind" Value="circle-check" />
                                    <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FlashOk}" Value="False">
                                            <Setter Property="Kind" Value="triangle-alert" />
                                            <Setter Property="Foreground" Value="{DynamicResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SvgIcon.Style>
                        </local:SvgIcon>
                        <TextBlock Text="{Binding Flash}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Footer. (No Restart: on Windows nothing supervises the daemon yet.) -->
            <DockPanel DockPanel.Dock="Bottom" Margin="18,0,12,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding Quit}" ToolTip="Quit the tray app (the daemon keeps running)">
                    <StackPanel Orientation="Horizontal">
                        <local:SvgIcon Kind="power" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="Quit" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Esc closes · Ctrl+1–4 switch tabs · Ctrl+F finds a contact" FontSize="10" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- The middle scrolls when it would run past the screen; header and footer stay put. -->
            <ScrollViewer x:Name="Middle" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,10" Focusable="False"
                          PreviewMouseWheel="Middle_PreviewMouseWheel">
                <Grid Margin="18,0">
                    <!-- Home -->
                    <StackPanel Visibility="{Binding MainPage, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource CardStyle}" Padding="18" Visibility="{Binding ShownProblem, Converter={StaticResource IfSet}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Subtle2}" HorizontalAlignment="Center">
                                    <local:SvgIcon Kind="unplug" Width="21" Height="21" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ShownProblem}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,4,0,0"
                                           Text="This panel checks again every 2 seconds and fills in as soon as the daemon answers." />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource Visible}}">
                            <Border Margin="0,0,0,12" CornerRadius="12" Padding="12,9" Background="{DynamicResource RedWash}" Visibility="{Binding ConfigError, Converter={StaticResource IfSet}}">
                                <DockPanel>
                                    <local:SvgIcon Kind="triangle-alert" Width="15" Height="15" DockPanel.Dock="Left" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                    <TextBlock Text="{Binding ConfigError}" FontSize="11" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>

                            <!-- Away right now: people who write get one reply. -->
                            <Border Margin="0,0,0,12" CornerRadius="12" Padding="12,9" Background="{DynamicResource BlueWash}" Visibility="{Binding AwayBadge, Converter={StaticResource IfSet}}">
                                <DockPanel>
                                    <local:SvgIcon Kind="moon" Width="15" Height="15" DockPanel.Dock="Left" Foreground="{DynamicResource Blue}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Fg}" TextWrapping="Wrap">
                                        <Run Text="{Binding AwayBadge, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": people who message you privately get an away reply if you don't answer." />
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTemplate}" Focusable="False" Margin="-4,0,-4,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Waiting for approval -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding WaitingShown, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="9" Background="{DynamicResource BadgeBg}" Padding="7,1" VerticalAlignment="Center"
                                                Visibility="{Binding ApprovalCount, Converter={StaticResource IfSet}}">
                                            <TextBlock Text="{Binding ApprovalCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BadgeFg}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Waiting for approval" />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding NoApprovals, Converter={StaticResource Visible}}">
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0" VerticalAlignment="Top" Background="{DynamicResource GreenWash}">
                                            <local:SvgIcon Kind="check" Width="17" Height="17" Foreground="{DynamicResource Green}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource EmptyTitle}" Text="You're all caught up" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Text="When Claude wants to message a chat that needs your OK, the draft waits here." />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Approvals}" ItemTemplate="{StaticResource ApprovalTemplate}" Focusable="False" />
                                </StackPanel>
                            </Border>

                            <!-- Listening -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding ListeningShown, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Listening now" />
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding NoListening, Converter={StaticResource Visible}}">
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <local:SvgIcon Kind="radio" Width="17" Height="17" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource EmptyTitle}" Text="No one is listening" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Text="Ask Claude to watch a chat. It can only watch chats with auto-reply on (the Auto-reply tile)." />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- What a switch does, in plain words. -->
                                    <Border Margin="0,10,0,0" CornerRadius="10" Background="{DynamicResource Subtle}" Padding="10,8"
                                            Visibility="{Binding NoListening, Converter={StaticResource Hidden}}">
                                        <DockPanel>
                                            <local:SvgIcon Kind="info" Width="15" Height="15" DockPanel.Dock="Left" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap"
                                                       Text="Each switch pauses or resumes a chat for every session listening to it. While it's paused, new messages there aren't passed to Claude; the watch stays." />
                                        </DockPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Listening}" ItemTemplate="{StaticResource SessionTemplate}" Focusable="False" />
                                </StackPanel>
                            </Border>

                            <!-- Auto-reply: both kinds in one place. The away reply's switch first (hours and message
                                 stay on the Away tab), then every saved chat with its auto-reply switch. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding AutoReplyShown, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding AwayQuickTip}"
                                                    Visibility="{Binding AwayShown, Converter={StaticResource Visible}}">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AwayOn, Mode=OneWay}" Command="{Binding ToggleAwayQuick}"
                                                          IsEnabled="{Binding AwayQuickIdle}" AutomationProperties.Name="Away auto-reply" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BlueWash}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <local:SvgIcon Kind="moon" Width="17" Height="17" Foreground="{DynamicResource Blue}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Away auto-reply" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding AwayShown, Converter={StaticResource Visible}}">
                                                <Run Text="{Binding AwayStatus, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" /><Run Text=". Replies to people who message you privately, on the schedules you set." />
                                            </TextBlock>
                                            <TextBlock Text="{Binding AwayPlaceholder}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Visibility="{Binding AwayPlaceholder, Converter={StaticResource IfSet}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Button Style="{StaticResource Flat}" Command="{Binding ShowAway}" HorizontalAlignment="Left" Margin="44,6,0,0"
                                            ToolTip="Open the Away tab (Ctrl+3)" Visibility="{Binding AwayShown, Converter={StaticResource Visible}}">
                                        <TextBlock Text="Schedules and messages" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Every saved chat with its auto-reply switch: choose who Claude may watch without opening Contacts. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="{Binding AutoReplyShown, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Command="{Binding ShowContacts}" VerticalAlignment="Center"
                                                ToolTip="Open Contacts for every chat's rules">
                                            <TextBlock Text="All settings" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                        </Button>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Auto-reply in chats" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Text="Switch a chat on and a Claude session can watch it and reply there without asking while it does. Off: no session can listen." />
                                    <TextBlock Text="{Binding MayListenPlaceholder}" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" Margin="0,10,0,0"
                                               Visibility="{Binding MayListenPlaceholder, Converter={StaticResource IfSet}}" />
                                    <ItemsControl ItemsSource="{Binding MayListen}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ContactVM}">
                                                <DockPanel Margin="0,10,0,0">
                                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="8,0,0,0"
                                                                  IsChecked="{Binding Listens, Mode=OneWay}" Command="{Binding ToggleListen}" IsEnabled="{Binding Idle}"
                                                                  AutomationProperties.Name="{Binding ListenName}" />
                                                    <Viewbox DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0">
                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContactAvatar}" Focusable="False" />
                                                    </Viewbox>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nickname}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ListenCaption}" FontSize="10" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource Flat}" Command="{Binding ToggleMayListen}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding MayListenMore, Converter={StaticResource IfSet}}">
                                        <TextBlock Text="{Binding MayListenMore}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Recently sent -->
                            <Border Style="{StaticResource CardStyle}" Visibility="{Binding SentShown, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Recently sent" />
                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding NoRecent, Converter={StaticResource Visible}}">
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                            <local:SvgIcon Kind="send" Width="17" Height="17" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource EmptyTitle}" Text="Nothing sent yet" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Messages Claude sends show up here. Click one to see what went out." />
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource RecentTemplate}" Focusable="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Contacts -->
                    <StackPanel Visibility="{Binding ContactsPage, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Visibility="{Binding ShownProblem, Converter={StaticResource IfSet}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <local:SvgIcon Kind="unplug" Width="17" Height="17" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ShownProblem}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Margin="0,0,0,10" CornerRadius="12" Padding="12,8" Background="{DynamicResource PendingWash}" Visibility="{Binding WaitingBanner, Converter={StaticResource IfSet}}">
                            <DockPanel>
                                <local:SvgIcon Kind="clock" Width="16" Height="16" DockPanel.Dock="Left" Foreground="{DynamicResource Orange}" Margin="0,0,8,0" />
                                <local:PillButton DockPanel.Dock="Right" Content="Review" Tint="{DynamicResource Orange}" Command="{Binding ReviewWaiting}" />
                                <TextBlock Text="{Binding WaitingBanner}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding ContactsPlaceholder, Converter={StaticResource IfSet}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <local:SvgIcon Kind="users" Width="17" Height="17" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ContactsPlaceholder}" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ContactRows}" ItemTemplate="{StaticResource ContactTemplate}" Focusable="False" />
                    </StackPanel>

                    <!-- Away -->
                    <StackPanel Visibility="{Binding AwayPage, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Visibility="{Binding ShownProblem, Converter={StaticResource IfSet}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <local:SvgIcon Kind="unplug" Width="17" Height="17" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ShownProblem}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding AwayPlaceholder, Converter={StaticResource IfSet}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <local:SvgIcon Kind="moon" Width="17" Height="17" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding AwayPlaceholder}" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <StackPanel Visibility="{Binding AwayShown, Converter={StaticResource Visible}}">
                            <!-- Where things stand: the master switch, what replies now, and today at a glance. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding AwayOn, Mode=OneWay}" Command="{Binding ToggleAwayQuick}" IsEnabled="{Binding AwayQuickIdle}"
                                                      ToolTip="{Binding AwayQuickTip}" AutomationProperties.Name="Away replies" />
                                        <Border x:Name="AwayHero" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource GrayWash}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AwayOnNow}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource GreenWash}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <local:SvgIcon Kind="{Binding AwayIcon}" Width="19" Height="19" HorizontalAlignment="Center">
                                                <local:SvgIcon.Style>
                                                    <Style TargetType="local:SvgIcon">
                                                        <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AwayOnNow}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Green}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:SvgIcon.Style>
                                            </local:SvgIcon>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AwayHeadline}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AwayStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="Today" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" Margin="0,16,0,8" />
                                    <local:DayTimeline Lanes="{Binding TimelineLanes}" Now="{Binding TimelineNow}" Margin="0,2,0,0"
                                                       ToolTip="Each line is a schedule; the white line is now. Faded: switched off." />

                                    <!-- A reply waiting out a schedule's delay. -->
                                    <Border Margin="0,12,0,0" CornerRadius="10" Padding="10,8" Background="{DynamicResource PendingWash}"
                                            Visibility="{Binding AwayWaiting, Converter={StaticResource IfSet}}">
                                        <DockPanel>
                                            <local:SvgIcon Kind="clock" Width="15" Height="15" DockPanel.Dock="Left" Foreground="{DynamicResource Orange}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                            <TextBlock Text="{Binding AwayWaiting}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- The schedules. -->
                            <DockPanel Margin="4,0,0,8">
                                <local:PillButton DockPanel.Dock="Right" Tint="{DynamicResource Accent}" Command="{Binding ShowAdd}"
                                                  ToolTip="Add a schedule: lunch, weekends, time off…">
                                    <StackPanel Orientation="Horizontal">
                                        <local:SvgIcon Kind="plus" Width="13" Height="13" Margin="0,0,5,0" />
                                        <TextBlock Text="Add" />
                                    </StackPanel>
                                </local:PillButton>
                                <TextBlock Text="Schedules" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- What to start a new schedule from. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Visibility="{Binding ShowTemplates, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <TextBlock Text="Start from" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" Text="Pick one, then change anything before you add it." />
                                    <ItemsControl ItemsSource="{Binding Templates}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:TemplateVM}">
                                                <local:PillButton Content="{Binding Label}" Tint="{DynamicResource Accent}" Margin="0,0,6,6" Command="{Binding Pick}" ToolTip="{Binding Tip}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10" Visibility="{Binding NoSchedulesYet, Converter={StaticResource IfSet}}">
                                <TextBlock Text="{Binding NoSchedulesYet}" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Schedules}" ItemTemplate="{StaticResource ScheduleTemplate}" Focusable="False" />

                            <!-- Who gets away replies: a saved person switched off is on away.skip and never gets one. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,2,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Who gets away replies" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Switch a person off and they never get an away reply. Sending, auto-reply and their other rules stay as they are." />
                                    <TextBlock Text="{Binding AwayPeoplePlaceholder}" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" Margin="0,10,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding AwayPeoplePlaceholder, Converter={StaticResource IfSet}}" />
                                    <ItemsControl ItemsSource="{Binding AwayPeople}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ContactVM}">
                                                <DockPanel Margin="0,10,0,0">
                                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="8,0,0,0"
                                                                  IsChecked="{Binding GetsAway, Mode=OneWay}" Command="{Binding ToggleAway}"
                                                                  AutomationProperties.Name="{Binding AwayName}" />
                                                    <Viewbox DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0">
                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContactAvatar}" Focusable="False" />
                                                    </Viewbox>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nickname}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding AwayCaption}" FontSize="10" Foreground="{DynamicResource Fg3}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- The rules every schedule follows. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,2,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="How away replies work" />
                                    <ItemsControl Margin="0,8,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource Fg3}" VerticalAlignment="Top" Margin="2,6,8,0" />
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <sys:String>Only people who message you privately get one. Groups, bots, Blocked chats, people switched off above and chats Claude is answering never do.</sys:String>
                                        <sys:String>They go out on their own, without waiting for your approval, also in Ask every time chats.</sys:String>
                                        <sys:String>A schedule that waits gives you time: read any chat or send a message on Telegram, on any device, and nothing goes out.</sys:String>
                                        <sys:String>When two schedules overlap, the one with dates wins, then the shorter one.</sys:String>
                                        <sys:String>At most 20 replies an hour and 30 in one day or night, and never two to the same chat within 30 minutes, so a burst of messages can't look like spam.</sys:String>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Quiet after you write" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="No away reply in a chat for this long after anything is sent from your account there, by you or by Claude. 0 turns this off." />
                                    <DockPanel>
                                        <local:PillButton DockPanel.Dock="Right" Content="Save" Filled="True" Tint="{DynamicResource AccentFill}" Command="{Binding SaveQuiet}" MinWidth="70"
                                                          Visibility="{Binding QuietDirty, Converter={StaticResource Visible}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="64" Text="{Binding AwayQuiet, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="Quiet minutes">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding SaveQuiet}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Text="minutes" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding QuietError}" FontSize="11" Foreground="{DynamicResource Red}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding QuietError, Converter={StaticResource IfSet}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel Visibility="{Binding FooterPage, Converter={StaticResource Visible}}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Visibility="{Binding ShownProblem, Converter={StaticResource IfSet}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Subtle2}" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <local:SvgIcon Kind="unplug" Width="17" Height="17" Foreground="{DynamicResource Fg2}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ShownProblem}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding FooterPlaceholder, Converter={StaticResource IfSet}}">
                            <TextBlock Text="{Binding FooterPlaceholder}" Style="{StaticResource Caption}" Foreground="{DynamicResource Fg2}" />
                        </Border>

                        <StackPanel Visibility="{Binding FooterShown, Converter={StaticResource Visible}}">
                            <!-- What people see: a message with the footer under it, as typed. -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding FooterOn, Mode=OneWay}" Command="{Binding ToggleFooter}" IsEnabled="{Binding FooterIdle}"
                                                      AutomationProperties.Name="Footer on or off"
                                                      ToolTip="Switch the footer on or off (saves at once; the text is kept)" />
                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                                            <local:SvgIcon Kind="type" Width="19" Height="19" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Message footer" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FooterStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Text="It goes under everything sent from your account for you: Claude's messages, away replies and page replies. Not under what you type yourself." />

                                    <!-- A chat, as the other person sees it. -->
                                    <Border Margin="0,12,0,0" CornerRadius="12" Background="{DynamicResource Subtle}" Padding="12,12,12,10">
                                        <StackPanel>
                                            <Border CornerRadius="14,14,4,14" Background="{DynamicResource AccentSoft}" Padding="11,8" HorizontalAlignment="Right" MaxWidth="280">
                                                <TextBlock Text="{Binding FooterPreview}" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="Preview, as they'll see it" FontSize="10" Foreground="{DynamicResource Fg3}" HorizontalAlignment="Right" Margin="0,5,2,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Make it yours" />

                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FooterCounter}" FontSize="10" Foreground="{DynamicResource Fg3}" VerticalAlignment="Bottom" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Text" />
                                    </DockPanel>
                                    <TextBox Text="{Binding FooterBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                             MinHeight="40" MaxHeight="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="298"
                                             AutomationProperties.Name="Footer text" />

                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Ideas" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="Start from one, then change it as you like. Emoji work too." />
                                    <ItemsControl ItemsSource="{Binding FooterIdeas}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <local:PillButton Content="{Binding}" Tint="{DynamicResource Accent}" Margin="0,0,6,6"
                                                                  Command="{Binding DataContext.UseFooterIdea, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Letters" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="Fancy letters that look the same in every Telegram app." />
                                    <ItemsControl ItemsSource="{Binding StyleChoices}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ChoiceVM}">
                                                <local:PillButton Content="{Binding Label}" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding On, Mode=OneWay}" Margin="0,0,6,6"
                                                                  Command="{Binding DataContext.SetFooterStyle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}" ToolTip="{Binding Tip}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource SettingTitle}" Text="Space above it" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="How it sits under the message." />
                                    <Border Style="{StaticResource Segments}">
                                        <ItemsControl ItemsSource="{Binding SpacingChoices}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:ChoiceVM}">
                                                    <local:PillButton Content="{Binding Label}" Choice="True" Tint="{DynamicResource AccentFill}" Filled="{Binding On, Mode=OneWay}"
                                                                      Command="{Binding DataContext.SetFooterSpacingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}" ToolTip="{Binding Tip}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <DockPanel Margin="0,12,0,0" Visibility="{Binding FooterError, Converter={StaticResource IfSet}}">
                                        <local:SvgIcon Kind="triangle-alert" Width="14" Height="14" DockPanel.Dock="Left" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,1,6,0" />
                                        <TextBlock Text="{Binding FooterError}" FontSize="11" Foreground="{DynamicResource Red}" TextWrapping="Wrap" />
                                    </DockPanel>

                                    <DockPanel Margin="0,16,0,0">
                                        <local:PillButton DockPanel.Dock="Left" Content="Reset" Tint="{DynamicResource Fg2}" Command="{Binding ResetFooter}"
                                                          ToolTip="Back to the default footer (not saved until you press Save)" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <local:PillButton Content="Discard" Tint="{DynamicResource Fg2}" Command="{Binding DiscardFooter}" Margin="0,0,8,0"
                                                              ToolTip="Put back what is saved" />
                                            <local:PillButton Content="Save" Filled="True" Tint="{DynamicResource AccentFill}" MinWidth="76" Command="{Binding SaveFooter}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
